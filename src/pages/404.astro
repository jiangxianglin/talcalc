---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClassPicker from '../components/ClassPicker.astro';
---

<BaseLayout
  title="Page not found – Talc"
  description="That page is missing. Pick a class talent calculator below."
  canonicalPath="/404"
  noindex={true}
>
  <h1 class="font-display text-3xl font-bold text-gold tracking-wide mb-3">Page not found</h1>
  <p class="text-ink-300 mb-8">
    The link may be old or mistyped. Head back to the{' '}
    <a href="/">talent calculator</a> or open a class below.
  </p>
  <ClassPicker />
</BaseLayout>
