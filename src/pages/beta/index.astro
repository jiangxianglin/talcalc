---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { meta, betaEntries, formatCheckedAt, classes } from '../../lib/data';

const title = 'Forever Client Build Changelog – Talc';
const description = `Client build changes tracked by Talc. Current dataset: ${meta.clientBuild}, checked ${formatCheckedAt(meta.checkedAt)}.`;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/beta/"
  ogImage="/og/home.png"
  activeNav="beta"
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Beta changelog' }]} />

  <h1 class="font-display text-3xl font-bold text-gold tracking-wide mb-3">Client build changelog</h1>
  <p class="text-ink-300 max-w-2xl mb-4">
    When Forever ships a new client build, we rebuild talent data here within 24 hours. Current
    dataset: build <span class="font-mono text-ink-100">{meta.clientBuild}</span>,{' '}
    {meta.totalTalents} talents across {classes.length} classes.
  </p>

  <aside class="panel p-4 mb-8 max-w-2xl text-sm text-ink-300 leading-relaxed space-y-2 border-gold/25">
    <h2 class="font-display text-base text-gold">Schedule note — name reservation next</h2>
    <p>
      Early Name Reservation runs{' '}
      <strong class="text-ink-100">October 27 – November 3, 2026</strong> with regional start times
      (NA 1:00 p.m. PDT / EU 18:00 CET / KR &amp; TW October 28 07:00). Summary of who qualifies and
      how to join:{' '}
      <a href="/name-reservation/">Forever name reservation page</a>.
    </p>
    <p>
      The Forever server stress test ran on{' '}
      <strong class="text-ink-100">October 21</strong> (moved from October 19). Wipe and join
      details remain on the{' '}
      <a href="/stress-test/">stress test page</a>.
    </p>
  </aside>
  <div class="panel p-4 mb-8 max-w-2xl text-sm text-ink-300 leading-relaxed space-y-2">
    <h2 class="font-display text-base text-gold">How the dataset is checked</h2>
    <p>
      Talent names, tree positions, prerequisites, max ranks, and rank text are imported from the{' '}
      <a href={meta.sourceUrl} rel="noopener noreferrer">public tool-maker export</a>
      {' '}({meta.source}). The page stamp is a dataset check date — not a claim that every in-game
      interaction was re-tested by hand.
    </p>
    <p>
      N / C / M marks come from our Classic Era comparison file (
      <code class="text-ink-100 text-xs">{meta.classicDiffSource ?? 'data/raw-talent-changes.csv'}</code>
      ), matched by class + talent name. Unmatched names stay unmarked as unchanged.
    </p>
    <p>
      Calculator rules (51 points, {meta.rowGate}-point row gates, maxRank, prerequisites) are
      enforced in the browser from that same JSON. If a rank text or gate looks wrong versus the
      client build on the page, prefer the client and report the mismatch so we can rebuild from
      the export.
    </p>
  </div>

  <ol class="space-y-8">
    {
      betaEntries.map((entry) => (
        <li class="panel p-5">
          <h2 class="font-display text-xl text-gold">
            Build <span class="font-mono">{entry.clientBuild}</span>
          </h2>
          <p class="text-ink-400 text-sm mt-1">Checked {formatCheckedAt(entry.checkedAt)}</p>
          <p class="text-ink-300 mt-3 text-sm leading-relaxed">{entry.summary}</p>
          <p class="font-mono text-xs text-ink-400 mt-3">
            +{entry.added} / ~{entry.changed} / −{entry.removed}
          </p>
          <ul class="mt-3 list-disc pl-5 text-sm text-ink-400 space-y-1">
            {entry.notes.map((n) => (
              <li>{n}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>

  <p class="mt-8 text-xs text-ink-500">
    Talent trees and statistics from{' '}
    <a href={meta.sourceUrl} rel="noopener noreferrer">wow-forever.gg</a>
    {' '}(
    <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener noreferrer license"
      >CC BY 4.0</a
    >
    )
  </p>
</BaseLayout>
