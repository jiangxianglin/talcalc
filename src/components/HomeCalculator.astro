---
import { classes, getTalentsForClass } from '../lib/data';
import TalentCalculator from './TalentCalculator.astro';
import { classIconUrl } from '../lib/icons';

const defaultSlug = classes.find((c) => c.slug === 'warrior')?.slug ?? classes[0].slug;
---

<section id="calculator" aria-labelledby="calc-heading" class="mb-14 scroll-mt-24">
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-5">
    <h2 id="calc-heading" class="font-display text-2xl sm:text-3xl text-gold tracking-wide">
      Talent calculator
    </h2>
    <p class="text-xs text-ink-400">
      Switch class without leaving the page — open a class page to sync a share URL
    </p>
  </div>

  <div
    class="flex flex-wrap gap-1.5 mb-6"
    role="tablist"
    aria-label="Class"
    data-home-tabs
  >
    {
      classes.map((c) => {
        const on = c.slug === defaultSlug;
        const accent = c.accent || '#c9a96e';
        return (
          <button
            type="button"
            role="tab"
            id={`tab-${c.slug}`}
            aria-selected={on ? 'true' : 'false'}
            aria-controls={`panel-${c.slug}`}
            data-tab={c.slug}
            data-accent={accent}
            class:list={[
              'px-3 py-1.5 text-sm rounded border inline-flex items-center gap-1.5 transition-colors cursor-pointer',
              on
                ? 'bg-ink-800 text-ink-100'
                : 'bg-ink-900/50 text-ink-400 hover:text-ink-100 border-ink-700',
            ]}
            style={
              on
                ? `border-color:${accent}; box-shadow: inset 0 -2px 0 ${accent}`
                : undefined
            }
          >
            <img
              src={classIconUrl(c.slug)}
              alt=""
              width="18"
              height="18"
              class="rounded-sm"
              data-tab-icon
              style={on ? undefined : 'filter:saturate(0.55);opacity:0.75'}
              loading="eager"
              decoding="async"
            />
            {c.name}
          </button>
        );
      })
    }
  </div>

  {
    classes.map((c) => {
      const on = c.slug === defaultSlug;
      const accent = c.accent || '#c9a96e';
      const talents = getTalentsForClass(c.slug);
      return (
        <div
          id={`panel-${c.slug}`}
          role="tabpanel"
          aria-labelledby={`tab-${c.slug}`}
          data-home-panel={c.slug}
          data-accent={accent}
          hidden={!on}
          class="rounded-lg border border-ink-700/90 bg-ink-950/40 p-2 sm:p-3 shadow-panel"
          style={`box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 0 40px color-mix(in srgb, ${accent} 12%, transparent)`}
        >
          <TalentCalculator
            classInfo={c}
            talents={talents}
            syncUrl={false}
            showLists={false}
            instanceId={`home-${c.slug}`}
            storageKey={`talc-draft-${c.slug}`}
          />
          <p class="mt-3 text-sm text-ink-400 px-1">
            Showing <span class="text-ink-100 font-medium">{c.name}</span> here.{' '}
            <a href={`/${c.slug}/`}>Open the full {c.name} calculator</a>
            {' '}
            to copy a share link as you spend points.
          </p>
        </div>
      );
    })
  }
</section>

<script>
  const tablist = document.querySelector<HTMLElement>('[data-home-tabs]');
  if (tablist) {
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(
      document.querySelectorAll<HTMLElement>('[data-home-panel]'),
    );

    function select(slug: string) {
      for (const tab of tabs) {
        const on = tab.dataset.tab === slug;
        const accent = tab.dataset.accent || '#c9a96e';
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.classList.toggle('bg-ink-800', on);
        tab.classList.toggle('text-ink-100', on);
        tab.classList.toggle('bg-ink-900/50', !on);
        tab.classList.toggle('text-ink-400', !on);
        tab.style.borderColor = on ? accent : '';
        tab.style.boxShadow = on ? `inset 0 -2px 0 ${accent}` : '';
        const icon = tab.querySelector<HTMLImageElement>('[data-tab-icon]');
        if (icon) {
          icon.style.filter = on ? '' : 'saturate(0.55)';
          icon.style.opacity = on ? '' : '0.75';
        }
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.homePanel !== slug;
      }
    }

    tablist.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tab]');
      if (!btn || !tablist.contains(btn)) return;
      const slug = btn.dataset.tab;
      if (slug) select(slug);
    });

    tablist.addEventListener('keydown', (e) => {
      const current = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tab]');
      if (!current) return;
      const i = tabs.indexOf(current);
      if (i < 0) return;
      let next = -1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % tabs.length;
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp')
        next = (i - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = tabs.length - 1;
      if (next < 0) return;
      e.preventDefault();
      tabs[next].focus();
      const slug = tabs[next].dataset.tab;
      if (slug) select(slug);
    });
  }
</script>
