---
import { classes, getTalentsForClass } from '../lib/data';
import TalentCalculator from './TalentCalculator.astro';
import { classIconUrl } from '../lib/icons';

/** Default interactive class on the home page (keeps HTML lean). */
const active = classes.find((c) => c.slug === 'warrior') ?? classes[0];
const talents = getTalentsForClass(active.slug);
---

<section id="calculator" aria-labelledby="calc-heading" class="mb-14 scroll-mt-24">
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-5">
    <h2 id="calc-heading" class="font-display text-2xl sm:text-3xl text-gold tracking-wide">
      Talent calculator
    </h2>
    <p class="text-xs text-ink-400">
      Pick a class for the full page — share URLs sync there
    </p>
  </div>

  <div
    class="flex flex-wrap gap-1.5 mb-6"
    role="tablist"
    aria-label="Class"
    data-home-tabs
  >
    {
      classes.map((c) => {
        const on = c.slug === active.slug;
        const accent = c.accent || '#c9a96e';
        return (
          <a
            href={`/${c.slug}/`}
            role="tab"
            id={`tab-${c.slug}`}
            aria-selected={on ? 'true' : 'false'}
            data-tab={c.slug}
            class:list={[
              'px-3 py-1.5 text-sm rounded border no-underline inline-flex items-center gap-1.5 transition-colors',
              on
                ? 'bg-ink-800 text-ink-100'
                : 'bg-ink-900/50 text-ink-400 hover:text-ink-100 border-ink-700',
            ]}
            style={`border-color:${on ? accent : undefined}; ${on ? `box-shadow: inset 0 -2px 0 ${accent}` : ''}`}
          >
            <img
              src={classIconUrl(c.slug)}
              alt=""
              width="18"
              height="18"
              class="rounded-sm"
              style={on ? undefined : 'filter:saturate(0.55);opacity:0.75'}
              loading="eager"
              decoding="async"
            />
            {c.name}
          </a>
        );
      })
    }
  </div>

  <div
    class="rounded-lg border border-ink-700/90 bg-ink-950/40 p-2 sm:p-3 shadow-panel"
    style={`box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 0 40px color-mix(in srgb, ${active.accent || '#c9a96e'} 12%, transparent)`}
  >
    <TalentCalculator
      classInfo={active}
      talents={talents}
      syncUrl={false}
      showLists={false}
      instanceId={`home-${active.slug}`}
      storageKey={`talc-draft-${active.slug}`}
    />
  </div>

  <p class="mt-3 text-sm text-ink-400">
    Showing <span class="text-ink-100 font-medium">{active.name}</span> here.{' '}
    <a href={`/${active.slug}/`}>Open the full {active.name} calculator</a>
    {' '}
    to copy a share link as you spend points.
  </p>
</section>
