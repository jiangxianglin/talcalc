{
  "name": "talc",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run data:build && npm run og:build && astro build && npm run check:html",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=talc --branch=master --commit-dirty=true",
    "preview": "astro preview",
    "data:build": "node scripts/build-data.mjs && node scripts/build-class-copy.mjs",
    "og:build": "node scripts/make-og.mjs",
    "check:html": "node scripts/check-html.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.0",
    "@astrojs/sitemap": "^3.4.0",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.10.0",
    "lz-string": "^1.5.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/lz-string": "^1.5.0",
    "typescript": "^5.8.3"
  }
}
